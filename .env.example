# ============ DATABASE (Turso / libSQL) ============
# Kosongkan NUXT_TURSO_URL untuk memakai file lokal .data/local.db (dev)
NUXT_TURSO_URL=libsql://your-db.turso.io
NUXT_TURSO_AUTH_TOKEN=your-turso-token

# ============ DROPBOX (upload file surat & arsip) ============
# PILIH SALAH SATU opsi token:
#  [A] OPSI ANJURAN — refresh token (tidak kedaluwarsa otomatis):
NUXT_DROPBOX_APP_KEY=your-dropbox-app-key
NUXT_DROPBOX_APP_SECRET=your-dropbox-app-secret
NUXT_DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
#  [B] FALLBACK — static token (kedaluwarsa ~4 jam, HARUS di-refresh manual):
NUXT_DROPBOX_TOKEN=your-dropbox-access-token
#
# Cara dapat refresh token (grammar dari .env.example):
#   1. https://www.dropbox.com/oauth2/authorize?client_id=<APP_KEY>&token_access_type=offline&response_type=code
#   2. Tukar code di POST https://api.dropboxapi.com/oauth2/token
#      (grant_type=authorization_code, code=..., client_id=..., client_secret=..., redirect_uri=...)
# Scope yang dibutuhkan: files.content.write + files.content.read

# ============ GOOGLE LOGIN (Login dengan Google) ============
# Ketiganya WAJIB jika fitur login Google dipakai (selain login admin biasa).
# Register redirect URI ini di Google Cloud Console juga.
NUXT_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_GOOGLE_CLIENT_SECRET=your-google-client-secret
NUXT_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============ SESSION ============
# NUXT_SESSION_SECRET dideklarasikan tapi TIDAK dipakai kode (session UUID random).
NUXT_SESSION_SECRET=change-me
# Masa aktif session dalam detik (default 86400 = 1 hari)
NUXT_SESSION_MAX_AGE=86400

# ============ INSTANSI (kop surat keluar, disposisi, laporan) ============
NUXT_PUBLIC_INSTANSI_NAMA=Pemerintah Provinsi Nusa Tenggara Timur
NUXT_PUBLIC_INSTANSI_UNIT=Dinas Pendidikan dan Kebudayaan
NUXT_PUBLIC_INSTANSI_SUB_UNIT=
NUXT_PUBLIC_INSTANSI_ALAMAT=

# ============ LOGO (kop surat / disposisi / laporan) ============
# Path di bawah /public. Kosong = tanpa logo (atau placeholder [Logo] di disposisi)
NUXT_PUBLIC_LOGO_PATH=/ntt.png

# ============ NOMOR SURAT KELUAR ============
NUXT_PUBLIC_NOMOR_TU=TU
NUXT_PUBLIC_NOMOR_UNIT=tekkomdik
NUXT_KLASIFIKASI_GOOGLE_URL=https://script.google.com/macros/s/AKfycby4RoU3dPXZWfkofZ5wVkNRKyG_V4x23ypfl-bRyrx7ahZ3i_NvFJ4lBntAANhiXjFyQQ/exec

# ============ WHATSAPP FONNTE ============
NUXT_FONNTE_TOKEN=your-fonnte-token
NUXT_FONNTE_ENABLED=false
NUXT_FONNTE_BASE_URL=https://api.fonnte.com/send
NUXT_APP_URL=http://localhost:3000

# ============ NAMA APLIKASI ============
NUXT_PUBLIC_APP_NAME=SIPERSA