# Turso (libSQL) — kosongkan untuk pakai file lokal .data/local.db saat dev
NUXT_TURSO_URL=libsql://your-db.turso.io
NUXT_TURSO_AUTH_TOKEN=your-token

# Dropbox (scope files.content.write + files.content.read)
# Statis/short-lived token — hanya fallback jika refresh token tidak diisi.
# Bisa di-generate di Dropbox App Console, tapi kedaluwarsa ~4 jam.
NUXT_DROPBOX_TOKEN=your-dropbox-access-token

# OAuth2 refresh token (disarankan, tidak kedaluwarsa otomatis).
# Ambil App Key + App Secret di App Console, lalu dapatkan refresh token via:
#   https://www.dropbox.com/oauth2/authorize?client_id=<APP_KEY>&token_access_type=offline&response_type=code
#   tukar code tsb di POST https://api.dropboxapi.com/oauth2/token
#     (grant_type=authorization_code, code=..., client_id=..., client_secret=..., redirect_uri=...)
NUXT_DROPBOX_APP_KEY=your-dropbox-app-key
NUXT_DROPBOX_APP_SECRET=your-dropbox-app-secret
NUXT_DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token

# Session
NUXT_SESSION_SECRET=change-me
NUXT_SESSION_MAX_AGE=86400

# Google OAuth (Login dengan Google)
# Buat OAuth 2.0 Client ID di Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: NUXT_GOOGLE_REDIRECT_URI (daftarkan juga di console).
NUXT_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_GOOGLE_CLIENT_SECRET=your-google-client-secret
NUXT_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Instansi (header lembar disposisi cetak)
NUXT_PUBLIC_INSTANSI_NAMA=Pemerintah Provinsi Nusa Tenggara Timur
NUXT_PUBLIC_INSTANSI_UNIT=Dinas Pendidikan dan Kebudayaan

# Nama aplikasi (sidebar header, title, login)
NUXT_PUBLIC_APP_NAME=SIPERSA
